# === ENVIRONMENT ===
NODE_ENV=development
PORT=3002
API_PORT=3002
WEB_PORT=3000
ADMIN_PORT=3001

# === DATABASE ===
DATABASE_URL=postgresql://user:password@localhost:5432/jdv_global
DATABASE_POOL_SIZE=20
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/jdv_global

# === SUPABASE ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# === REDIS ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# === JWT & AUTH ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# === PAYMENT PROVIDERS ===
# FedaPay
FEDAPAY_SECRET_KEY=your-fedapay-secret-key
FEDAPAY_PUBLIC_KEY=your-fedapay-public-key
FEDAPAY_SANDBOX_MODE=true

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox

# === CURRENCY & LOCALIZATION ===
DEFAULT_CURRENCY=XOF
DEFAULT_LANGUAGE=fr
SUPPORTED_CURRENCIES=XOF,USD,EUR,NGN,KES,ZAR,INR,CNY,BRL,MXN
SUPPORTED_LANGUAGES=fr,en,pt,es,zh,ar,sw,yo,wo,hi

# Currency Exchange API
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# === GOOGLE SERVICES ===
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CLOUD_PROJECT_ID=your-google-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json

# === AWS ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=jdv-global-uploads
AWS_CLOUDFRONT_DOMAIN=https://cdn.jdvglobal.com

# === EMAIL & SMS ===
# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@jdvglobal.com

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# === THIRD-PARTY SERVICES ===
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3002/auth/github/callback

# === MONITORING & LOGGING ===
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=debug
LOG_FORMAT=json

# === FRONTEND ===
REACT_APP_API_URL=http://localhost:3002
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
REACT_APP_SENTRY_DSN=your-sentry-dsn

# === MOBILE ===
MOBILE_API_ENDPOINT=https://api.jdvglobal.com
MOBILE_SOCKET_ENDPOINT=wss://socket.jdvglobal.com

# === SECURITY ===
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === FEATURES FLAGS ===
FEATURE_JDV_PAY_ENABLED=true
FEATURE_JDV_MARKET_ENABLED=true
FEATURE_JDV_IMMO_ENABLED=true
FEATURE_JDV_TRANSPORT_ENABLED=true
FEATURE_JDV_DELIVERY_ENABLED=true
FEATURE_JDV_TRAVEL_ENABLED=true
FEATURE_JDV_TOURISM_ENABLED=true
FEATURE_JDV_HEALTH_ENABLED=false
FEATURE_JDV_JOBS_ENABLED=true
FEATURE_JDV_ACADEMY_ENABLED=true
FEATURE_JDV_BUSINESS_ENABLED=true
FEATURE_JDV_BANK_ENABLED=false
FEATURE_JDV_AGRICULTURE_ENABLED=true

# === VERSION ===
APP_VERSION=1.0.0
APP_NAME=JDV GLOBAL